---
import '../styles/global.css';
const { title='Raghav Dharani — Product Leader', description='Selected work in enterprise software, applied AI and complex operations.', canonical='/' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f5f3ee" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(canonical, Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={new URL(canonical, Astro.site)} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="shell">
    <header class="masthead">
      <a class="brand" href="/" aria-label="Raghav Dharani, home">Raghav Dharani<span class="brand-period">.</span></a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/#work">Selected work</a>
        <a href="/#experience">Experience</a>
        <a href="/#about">About</a>
      </nav>
      <a class="nav-contact" href="mailto:raghav.dharani@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer"><span>© 2026 Raghav Dharani</span><span>New York · Product leadership · Enterprise software</span><a href="https://www.linkedin.com/in/raghavdharani" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></footer>
  </div>
</body>
</html>
